diff -ruN a/app/dispatcher/ratelimit.go b/app/dispatcher/ratelimit.go
--- a/app/dispatcher/ratelimit.go	1970-01-01 08:00:00.000000000 +0800
+++ b/app/dispatcher/ratelimit.go	2026-11-20 12:34:23.864745100 +0800
@@ -0,0 +1,240 @@
+package dispatcher
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+)
+
+// Per-user bandwidth limits live in a side file instead of the protobuf config
+// so this patch stays small when rebasing onto a new xray-core. The panel writes
+// the file and points XRAY_RATELIMIT_FILE at it.
+//
+//	{"users":{"alice@example.com":{"up":125000,"down":1000000}}}
+//
+// Values are bytes per second; 0 (or a missing side) means unlimited.
+
+type rateLimitEntry struct {
+	Up   int64 `json:"up"`
+	Down int64 `json:"down"`
+}
+
+type rateLimitFile struct {
+	Users map[string]rateLimitEntry `json:"users"`
+}
+
+type tokenBucket struct {
+	label  string
+	bytes  int64
+	start  time.Time
+	waits  int64
+	mu     sync.Mutex
+	rate   float64
+	burst  float64
+	tokens float64
+	last   time.Time
+}
+
+func newTokenBucket(label string, bytesPerSecond int64) *tokenBucket {
+	if os.Getenv("XRAY_RATELIMIT_DEBUG") != "" {
+		fmt.Fprintf(os.Stderr, "D3XDEBUG bucket %s rate=%d\n", label, bytesPerSecond)
+	}
+	rate := float64(bytesPerSecond)
+	burst := rate / 4
+	if burst < 64*1024 {
+		burst = 64 * 1024
+	}
+	return &tokenBucket{label: label, rate: rate, burst: burst, tokens: burst, last: time.Now(), start: time.Now()}
+}
+
+// wait blocks until n bytes fit in the bucket. Concurrent connections of the
+// same user share one bucket, so a client cannot multiply its limit by opening
+// more streams.
+func (b *tokenBucket) wait(n int) {
+	if n <= 0 || b.rate <= 0 {
+		return
+	}
+	for {
+		b.mu.Lock()
+		now := time.Now()
+		b.tokens += now.Sub(b.last).Seconds() * b.rate
+		b.last = now
+		// The cap only bounds idle accumulation. A single request larger than
+		// the nominal burst (a Close() flush, a big upstream read) must still
+		// be grantable, so let the ceiling rise to n for that request.
+		ceiling := b.burst
+		if float64(n) > ceiling {
+			ceiling = float64(n)
+		}
+		if b.tokens > ceiling {
+			b.tokens = ceiling
+		}
+		if b.tokens >= float64(n) {
+			b.tokens -= float64(n)
+			b.bytes += int64(n)
+			b.waits++
+			if os.Getenv("XRAY_RATELIMIT_DEBUG") != "" && b.waits%2000 == 0 {
+				elapsed := time.Since(b.start).Seconds()
+				fmt.Fprintf(os.Stderr, "D3XDEBUG %s waits=%d bytes=%d elapsed=%.1fs achieved=%.0f B/s\n", b.label, b.waits, b.bytes, elapsed, float64(b.bytes)/elapsed)
+			}
+			b.mu.Unlock()
+			return
+		}
+		// Sleep exactly long enough for the ungranted remainder to accrue, and
+		// KEEP the tokens we already hold. The previous version zeroed the
+		// counter here and slept only (n - tokens)/rate, so it woke up with
+		// fewer than n tokens and oscillated forever — the "0 B/s once the
+		// burst runs out" bug.
+		deficit := float64(n) - b.tokens
+		b.mu.Unlock()
+		time.Sleep(time.Duration(deficit / b.rate * float64(time.Second)))
+	}
+}
+
+type userRateLimit struct {
+	up   *tokenBucket
+	down *tokenBucket
+}
+
+var (
+	rateLimitFileMu     sync.Mutex
+	rateLimitFilePath   string
+	rateLimitUsers      atomic.Value // map[string]*userRateLimit
+	rateLimitLoadedAt   atomic.Int64
+	rateLimitFileStamp  atomic.Int64
+	rateLimitReloadEach = 2 * time.Second
+)
+
+func init() {
+	p := os.Getenv("XRAY_RATELIMIT_FILE")
+	if os.Getenv("XRAY_RATELIMIT_DEBUG") != "" {
+		fmt.Fprintf(os.Stderr, "D3XDEBUG init XRAY_RATELIMIT_FILE=%q\n", p)
+	}
+	if p != "" {
+		SetRateLimitFile(p)
+	}
+}
+
+// SetRateLimitFile enables per-user shaping from path. An empty path disables it.
+func SetRateLimitFile(path string) {
+	rateLimitFileMu.Lock()
+	rateLimitFilePath = path
+	rateLimitFileMu.Unlock()
+	rateLimitUsers.Store(map[string]*userRateLimit(nil))
+	rateLimitLoadedAt.Store(0)
+}
+
+func currentRateLimitFile() string {
+	rateLimitFileMu.Lock()
+	defer rateLimitFileMu.Unlock()
+	return rateLimitFilePath
+}
+
+// lookupRateLimit returns the buckets for email, reloading the side file when its
+// mtime changes. It is called once per connection, not per packet.
+func lookupRateLimit(email string) *userRateLimit {
+	path := currentRateLimitFile()
+	if os.Getenv("XRAY_RATELIMIT_DEBUG") != "" {
+		fmt.Fprintf(os.Stderr, "D3XDEBUG lookup email=%q path=%q\n", email, path)
+	}
+	if path == "" || email == "" {
+		return nil
+	}
+	now := time.Now().UnixNano()
+	if now-rateLimitLoadedAt.Load() >= int64(rateLimitReloadEach) {
+		rateLimitLoadedAt.Store(now)
+		if info, err := os.Stat(path); err == nil {
+			stamp := info.ModTime().UnixNano() ^ info.Size()
+			if stamp != rateLimitFileStamp.Load() {
+				rateLimitFileStamp.Store(stamp)
+				loadRateLimitFile(path)
+			}
+		}
+	}
+	if users, ok := rateLimitUsers.Load().(map[string]*userRateLimit); ok {
+		return users[email]
+	}
+	return nil
+}
+
+func loadRateLimitFile(path string) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return
+	}
+	var parsed rateLimitFile
+	if err := json.Unmarshal(raw, &parsed); err != nil {
+		return
+	}
+	users := make(map[string]*userRateLimit, len(parsed.Users))
+	for email, entry := range parsed.Users {
+		limit := &userRateLimit{}
+		if entry.Up > 0 {
+			limit.up = newTokenBucket("up", entry.Up)
+		}
+		if entry.Down > 0 {
+			limit.down = newTokenBucket("down", entry.Down)
+		}
+		if limit.up != nil || limit.down != nil {
+			users[email] = limit
+		}
+	}
+	rateLimitUsers.Store(users)
+}
+
+// rateLimitWriter shapes one direction of a user's link.
+type rateLimitWriter struct {
+	writer buf.Writer
+	bucket *tokenBucket
+}
+
+func newRateLimitWriter(writer buf.Writer, bucket *tokenBucket) *rateLimitWriter {
+	return &rateLimitWriter{writer: writer, bucket: bucket}
+}
+
+func (w *rateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	for i, b := range mb {
+		w.bucket.wait(int(b.Len()))
+		if err := w.writer.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+			buf.ReleaseMulti(mb[i+1:])
+			return err
+		}
+	}
+	return nil
+}
+
+// rateLimitReader shapes the download direction of a DispatchLink link.
+type rateLimitReader struct {
+	reader buf.Reader
+	bucket *tokenBucket
+}
+
+func newRateLimitReader(reader buf.Reader, bucket *tokenBucket) *rateLimitReader {
+	return &rateLimitReader{reader: reader, bucket: bucket}
+}
+
+func (r *rateLimitReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.reader.ReadMultiBuffer()
+	if mb != nil {
+		r.bucket.wait(int(mb.Len()))
+	}
+	return mb, err
+}
+
+func (r *rateLimitReader) Interrupt() {
+	common.Interrupt(r.reader)
+}
+
+func (w *rateLimitWriter) Interrupt() {
+	common.Interrupt(w.writer)
+}
+
+func (w *rateLimitWriter) Close() error {
+	return common.Close(w.writer)
+}
diff -ruN a/app/dispatcher/ratelimit_test.go b/app/dispatcher/ratelimit_test.go
--- a/app/dispatcher/ratelimit_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/app/dispatcher/ratelimit_test.go	2026-11-20 12:34:24.003249600 +0800
@@ -0,0 +1,135 @@
+package dispatcher
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+func writeLimits(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "ratelimit.json")
+	if err := os.WriteFile(path, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestRateLimitFileLoadsPerUser(t *testing.T) {
+	path := writeLimits(t, `{"users":{"a@x":{"up":125000,"down":1000000},"b@x":{"down":500000}}}`)
+	SetRateLimitFile(path)
+	defer SetRateLimitFile("")
+
+	users := map[string]*userRateLimit{}
+	for _, email := range []string{"a@x", "b@x", "c@x"} {
+		users[email] = lookupRateLimit(email)
+	}
+	if users["a@x"] == nil || users["b@x"] == nil {
+		t.Fatal("configured users missing")
+	}
+	if users["c@x"] != nil {
+		t.Fatal("unlimited user got a bucket")
+	}
+	if users["a@x"].up == nil || users["a@x"].down == nil {
+		t.Fatal("a@x should shape both directions")
+	}
+	if users["b@x"].up != nil {
+		t.Fatal("b@x has no upload limit")
+	}
+}
+
+func TestRateLimitFileReloadsOnChange(t *testing.T) {
+	path := writeLimits(t, `{"users":{"a@x":{"down":1000}}}`)
+	SetRateLimitFile(path)
+	defer SetRateLimitFile("")
+
+	if lookupRateLimit("a@x") == nil {
+		t.Fatal("initial load missed")
+	}
+	time.Sleep(5 * time.Millisecond)
+	if err := os.WriteFile(path, []byte(`{"users":{}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// The reload interval is 2s; shrink it for the test.
+	old := rateLimitReloadEach
+	rateLimitReloadEach = 0
+	defer func() { rateLimitReloadEach = old }()
+	if lookupRateLimit("a@x") != nil {
+		t.Fatal("removed limit survived reload")
+	}
+}
+
+func TestTokenBucketSpreadsLargeWrites(t *testing.T) {
+	b := newTokenBucket("down", 100000) // 100 kB/s
+	start := time.Now()
+	b.wait(100000) // burst is 64 KiB, so ~360ms must be paid
+	elapsed := time.Since(start)
+	if elapsed < 250*time.Millisecond {
+		t.Fatalf("bucket drained too fast: %v", elapsed)
+	}
+	if elapsed > 2*time.Second {
+		t.Fatalf("bucket too slow: %v", elapsed)
+	}
+}
+
+// TestTokenBucketSustainedRate keeps asking for small chunks after the burst is
+// exhausted. The old bucket zeroed the token counter before sleeping only for
+// the deficit, so it woke up with (n - old_tokens) tokens — never enough for n —
+// and oscillated forever. That showed up as 0 B/s once the burst ran out.
+func TestTokenBucketSustainedRate(t *testing.T) {
+	b := newTokenBucket("down", 100000) // 100 kB/s, burst 64 KiB
+	start := time.Now()
+	for i := 0; i < 20; i++ {
+		b.wait(10000)
+	}
+	elapsed := time.Since(start)
+	// 200 kB at 100 kB/s ≈ 2s, minus the initial burst credit (~0.65s) → 1.35s.
+	if elapsed < 500*time.Millisecond {
+		t.Fatalf("200kB at 100kB/s finished too fast: %v", elapsed)
+	}
+	if elapsed > 5*time.Second {
+		t.Fatalf("200kB at 100kB/s took too long (stalling?): %v", elapsed)
+	}
+}
+
+// TestTokenBucketLargerThanBurst covers a single write bigger than the bucket
+// capacity (e.g. the flush in shaperWriter.Close or a big upstream read). The
+// token cap must not be able to strand a request below n forever.
+func TestTokenBucketLargerThanBurst(t *testing.T) {
+	b := newTokenBucket("down", 200000) // burst = max(50 kB, 64 KiB) = 64 KiB
+	start := time.Now()
+	b.wait(150000) // 150 kB > burst
+	elapsed := time.Since(start)
+	if elapsed > 3*time.Second {
+		t.Fatalf("wait larger than burst took too long: %v", elapsed)
+	}
+}
+
+// TestTokenBucketConcurrentSharesLimit opens 4 streams on one bucket. Total
+// throughput must stay near the configured rate — that is the acceptance
+// criterion for "4 concurrent connections still capped in aggregate".
+func TestTokenBucketConcurrentSharesLimit(t *testing.T) {
+	b := newTokenBucket("down", 200000) // 200 kB/s shared
+	start := time.Now()
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 10; j++ {
+				b.wait(20000) // 200 kB total per stream, 800 kB combined
+			}
+		}()
+	}
+	wg.Wait()
+	elapsed := time.Since(start)
+	// 800 kB at 200 kB/s = 4s, minus burst credit 64 KiB ≈ 0.3s.
+	if elapsed < 2500*time.Millisecond {
+		t.Fatalf("4 streams leaked past the shared limit: %v", elapsed)
+	}
+	if elapsed > 10*time.Second {
+		t.Fatalf("4 streams starved: %v", elapsed)
+	}
+}
diff -ruN a/app/dispatcher/shaper.go b/app/dispatcher/shaper.go
--- a/app/dispatcher/shaper.go	1970-01-01 08:00:00.000000000 +0800
+++ b/app/dispatcher/shaper.go	2026-11-20 12:34:23.928204700 +0800
@@ -0,0 +1,71 @@
+package dispatcher
+
+import (
+	"os"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+)
+
+// shaperWriter paces one direction of a link.
+//
+// The write stays on the producer's goroutine — Xray's link writers are not
+// safe to call from another goroutine. The bucket is charged first, then the
+// buffers go straight through in their natural size.
+//
+// Earlier revisions batched data until 64 KiB had accumulated. That deadlocks
+// request/response flows: the TLS handshake's first flight is a few KiB, the
+// peer blocks waiting for it, and the batch never fills, so nothing moves at
+// all. The initial burst covers handshakes, and the pacing sleep between
+// chunks is what throttles the bulk transfer.
+type shaperWriter struct {
+	target buf.Writer
+	limit  *tokenBucket
+}
+
+func newShaperWriter(target buf.Writer, limit *tokenBucket) *shaperWriter {
+	return &shaperWriter{target: target, limit: limit}
+}
+
+func (s *shaperWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if n := int(mb.Len()); n > 0 {
+		s.limit.wait(n)
+	}
+	return s.target.WriteMultiBuffer(mb)
+}
+
+func (s *shaperWriter) Interrupt() {
+	common.Interrupt(s.target)
+}
+
+func (s *shaperWriter) Close() error {
+	return common.Close(s.target)
+}
+
+// shaperReader paces the other direction. Uploads are small, so a blocking
+// read is enough and avoids a second buffer queue.
+type shaperReader struct {
+	reader buf.Reader
+	limit  *tokenBucket
+}
+
+func newShaperReader(reader buf.Reader, limit *tokenBucket) *shaperReader {
+	return &shaperReader{reader: reader, limit: limit}
+}
+
+func (r *shaperReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.reader.ReadMultiBuffer()
+	if mb != nil {
+		r.limit.wait(int(mb.Len()))
+	}
+	return mb, err
+}
+
+func (r *shaperReader) Interrupt() {
+	common.Interrupt(r.reader)
+}
+
+// debugEnabled reports whether the limiter should print its counters.
+func debugEnabled() bool {
+	return os.Getenv("XRAY_RATELIMIT_DEBUG") != ""
+}
