#!/sbin/openrc-run

command="/usr/local/d3x-ui/d3x-ui"
command_background=true
pidfile="/run/d3x-ui.pid"
description="d3x-ui Service"
procname="d3x-ui"
depend() {
    need net
}
start_pre(){
    cd /usr/local/d3x-ui
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}